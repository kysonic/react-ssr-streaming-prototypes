{
  "name": "react-ssr-streaming-node",
  "version": "0.0.1",
  "description": "Node.js React SSR streaming",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm build:client --watch=forever & tsx watch ./index.ts",
    "build:client": "esbuild src/client/index.tsx --bundle --outfile=public/build/client.js --jsx=automatic --define:process.env.NODE_ENV=\\\"development\\\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
